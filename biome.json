{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "web/**",
      "worker/**",
      "shared/**",
      "!web/public",
      "!**/dist",
      "!**/node_modules",
      "!**/.wrangler",
      "!worker/worker-configuration.d.ts",
      "!shared/fixtures/jamie/real"
