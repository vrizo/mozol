# Cloudflare token for dev and deploy: docs/security/cloudflare-tokens.md. chmod 600 .env
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# App Store Connect API key for TestFlight uploads: docs/deployment/testflight.md.
# The key file stays at ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8.
ASC_KEY_ID=
ASC_ISSUER_ID=

# Worker secrets: docs/deployment/infrastructure.md
ANTHROPIC_API_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# Base64 text of the .p8 key between its BEGIN and END lines, joined into one line: docs/backend/push.md
APNS_PRIVATE_KEY=
# The whole .p8 file, base64 in one line, for scripts/apns-push.mjs: docs/ios/push-testing.md
APNS_PRIVATE_KEY_BASE64=
