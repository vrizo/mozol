# Cloudflare token for dev and deploy: docs/security/cloudflare-tokens.md. chmod 600 .env
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# App Store Connect API key for TestFlight uploads: docs/deployment/testflight.md.
# The key file stays at ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8.
ASC_KEY_ID=
ASC_ISSUER_ID=

# APNs auth key for pushes: docs/ios/push-testing.md. The .p8 file, base64 in one line.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_BASE64=
